# ==============================================================================
# PII-PHI Document Intelligence Platform Configuration
# ==============================================================================

# Database connection URL for SQLAlchemy engine (PostgreSQL target)
DATABASE_URL=postgresql://postgres:22691a31i5@localhost:5432/pii_phi_document_intelligence_poc

# Connection URL for Ollama service instance hosting Qwen SLM and LLM models
# Defaults to http://localhost:11434 if not specified
OLLAMA_HOST=http://localhost:11434

# Enable/disable slow local LLM reasoning during CPU tests.
# Set to 'true' to run traditional engines (Regex, Presidio, GLiNER, MedSpaCy) at full speed
# and bypass slow Qwen semantic validation.
BYPASS_LLM=false