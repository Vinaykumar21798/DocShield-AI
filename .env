# ==========================================
# Application
# ==========================================
APP_NAME=PII-PHI Document Intelligence PoC
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

# ==========================================
# PostgreSQL Database
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pii_phi_document_intelligence_poc
DB_USER=postgres
DB_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pii_phi_document_intelligence_poc

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

REDIS_URL=redis://localhost:6379/0

# ==========================================
# Storage
# ==========================================
UPLOAD_DIR=storage/uploads
EXTRACTED_DIR=storage/extracted

# ==========================================
# File Upload
# ==========================================
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,xlsx,xls,txt,png,jpg,jpeg,tiff,bmp

# ==========================================
# OCR
# ==========================================
OCR_ENGINE=paddleocr
OCR_LANGUAGE=en

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# Security
# ==========================================
SECRET_KEY=change_this_to_a_secure_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# API
# ==========================================
API_PREFIX=/api/v1