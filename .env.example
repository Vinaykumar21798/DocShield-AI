# ==========================
# Application
# ==========================
APP_NAME=DocShield-AI
APP_VERSION=1.0.0
DEBUG=True

# ==========================
# FastAPI
# ==========================
HOST=0.0.0.0
PORT=8000

# ==========================
# PostgreSQL
# ==========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pii_phi_document_intelligence_poc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pii_phi_document_intelligence_poc

# ==========================
# Redis
# ==========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

# ==========================
# Processing Jobs
# ==========================
PROCESSING_JOB_MAX_RETRIES=3

# ==========================
# Optional LLM Validation
# ==========================
BYPASS_LLM=True
OLLAMA_REQUIRED=False
OLLAMA_HOST=http://localhost:11434
OLLAMA_REQUIRED_MODELS=qwen2.5:8b,qwen3:4b

# ==========================
# PaddleOCR Layout
# ==========================
PADDLEOCR_LAYOUT_ANALYSIS_ENABLED=True

# ==========================
# Uploads
# ==========================
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=100

# ==========================
# Startup Validation
# ==========================
STARTUP_VALIDATION_ENABLED=True
