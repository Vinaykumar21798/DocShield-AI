# ==========================
# Local Python template
# Copy to .env.local or run .\scripts\local-init.ps1.
# Update POSTGRES_PASSWORD and DATABASE_URL before running locally.
# Docker Compose does not use this file; Docker values are pinned in docker-compose.yml.
# ==========================

APP_NAME=DocShield-AI
APP_VERSION=1.0.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pii_phi_document_intelligence_poc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/pii_phi_document_intelligence_poc

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

PROCESSING_JOB_MAX_RETRIES=3

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_DENSE_TABLE_NUM_PREDICT=1536
OLLAMA_TEMPERATURE=0.10
# Composite hourly cost of the Ollama host (cloud instance price, or local
# hardware amortization plus electricity). Leave blank if unknown.
GEMMA_COMPUTE_COST_PER_HOUR_USD=
BYPASS_LLM=false
OLLAMA_REQUIRED=False
OLLAMA_REQUIRED_MODELS=gemma4:e4b
GLINER_ALLOW_MODEL_DOWNLOAD=True
HF_HOME=.cache/huggingface

# Azure OpenAI pay-as-you-go rates for the configured deployment. Obtain the
# subscription/deployment-specific USD rates from Azure Portal or your rate
# card. Leave blank to report tokens while showing cost as not configured.
AZURE_OPENAI_INPUT_COST_PER_1M=
AZURE_OPENAI_CACHED_INPUT_COST_PER_1M=
AZURE_OPENAI_OUTPUT_COST_PER_1M=

DETECTION_HIGH_CONFIDENCE_THRESHOLD=0.80
DETECTION_MEDIUM_CONFIDENCE_THRESHOLD=0.60
DETECTION_STOPPING_CANDIDATE_THRESHOLD=0
DETECTION_MIN_CANDIDATE_CHARS=3

PADDLEOCR_LAYOUT_ANALYSIS_ENABLED=True

# Authentication
AUTH_TOKEN_TTL_HOURS=24
AUTH_PBKDF2_ITERATIONS=600000

UPLOAD_DIR=storage/uploads
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=100

STARTUP_VALIDATION_ENABLED=True
