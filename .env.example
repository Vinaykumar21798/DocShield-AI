# ==========================
# Local Python template
# Copy to .env.local or run .\scripts\local-init.ps1.
# Update POSTGRES_PASSWORD and DATABASE_URL before running locally.
# Docker Compose does not use this file; Docker values are pinned in docker-compose.yml.
# ==========================

APP_NAME=DocShield-AI
APP_VERSION=1.0.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pii_phi_document_intelligence_poc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@127.0.0.1:5432/pii_phi_document_intelligence_poc

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

PROCESSING_JOB_MAX_RETRIES=3

OLLAMA_HOST=http://localhost:11434
BYPASS_LLM=false
OLLAMA_REQUIRED=False
OLLAMA_REQUIRED_MODELS=qwen3:4b
GLINER_ALLOW_MODEL_DOWNLOAD=True
HF_HOME=.cache/huggingface

DETECTION_HIGH_CONFIDENCE_THRESHOLD=0.80
DETECTION_MEDIUM_CONFIDENCE_THRESHOLD=0.60
DETECTION_STOPPING_CANDIDATE_THRESHOLD=0
DETECTION_MIN_CANDIDATE_CHARS=3

PADDLEOCR_LAYOUT_ANALYSIS_ENABLED=True

UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=100

STARTUP_VALIDATION_ENABLED=True
